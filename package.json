{
  "name": "neurofit-gym-platform",
  "version": "1.0.0",
  "description": "Premium white-label gym website platform",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "cd client && npm run dev",
    "server": "cd server && npm run dev",
    "install-all": "npm install && cd client && npm install && cd ../server && npm install",
    "build": "cd client && npm run build",
    "seed": "cd server && node config/seed.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": ["gym", "fitness", "white-label", "platform"],
  "license": "MIT"
}
